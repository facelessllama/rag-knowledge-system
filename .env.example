OLLAMA_URL=http://localhost:11435
LLM_MODEL=qwen2.5:7b
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=change-me-generate-a-random-value
# POSTGRES_URL is what the Python app connects with; POSTGRES_USER/
# PASSWORD/DB below are what docker-compose.yml uses to configure the
# Postgres container itself — all four must describe the SAME credentials,
# or the container comes up with one password while the app tries another.
POSTGRES_URL=postgresql://raguser:change-me@localhost:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
LANGFUSE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Read by docker-compose.yml to configure the Langfuse container itself.
# Generate both with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LANGFUSE_NEXTAUTH_SECRET=change-me-generate-a-random-value
LANGFUSE_SALT=change-me-generate-a-random-value
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# RAG tuning
# RELEVANCE_THRESHOLD is a cross-encoder rerank logit, not a 0-1 similarity
# score — see the comment above RELEVANCE_THRESHOLD in api/main.py before
# changing this, and re-run eval/run_eval.py to re-calibrate.
RELEVANCE_THRESHOLD=3.0
MAX_CONCURRENT_QUERIES=3
TEMPERATURE=0.1
MAX_TOKENS=1024
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
QUERY_EXPANDER_MODEL=qwen2.5:7b
PDF_OCR_LANGUAGE=eng

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=your-token-from-botfather

# API authentication (leave empty to disable)
API_KEY=your-secret-key-here
