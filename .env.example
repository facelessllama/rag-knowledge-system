OLLAMA_URL=http://localhost:11435
LLM_MODEL=qwen2.5:7b
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
# Bounds every Qdrant REST call VectorStore makes (full request round trip,
# not just connect) — passed straight to QdrantClient(timeout=...). Metadata
# mutation reconciliation (folder sync, delete) layers a wait_for() on top
# sized at 3x this value as a pure backstop — see QDRANT_RECONCILE_TIMEOUT_
# SECONDS's comment in api/main.py for why it must stay strictly larger.
QDRANT_REQUEST_TIMEOUT_SECONDS=5
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=change-me-generate-a-random-value
# POSTGRES_URL is what the Python app connects with; POSTGRES_USER/
# PASSWORD/DB below are what docker-compose.yml uses to configure the
# Postgres container itself — all four must describe the SAME credentials,
# or the container comes up with one password while the app tries another.
POSTGRES_URL=postgresql://raguser:change-me@localhost:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
# The API's dedicated Postgres advisory-lock session is checked immediately
# before readiness and then periodically.  A failed or timed-out check makes
# the process exit rather than continue with unsafe process-local registries.
SINGLE_INSTANCE_WATCHDOG_INTERVAL_SECONDS=5
SINGLE_INSTANCE_WATCHDOG_TIMEOUT_SECONDS=5
LANGFUSE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Read by docker-compose.yml to configure the Langfuse container itself.
# Generate both with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LANGFUSE_NEXTAUTH_SECRET=change-me-generate-a-random-value
LANGFUSE_SALT=change-me-generate-a-random-value
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50

# RAG tuning
# RELEVANCE_THRESHOLD is a cross-encoder rerank logit, not a 0-1 similarity
# score — see the comment above RELEVANCE_THRESHOLD in api/main.py before
# changing this, and re-run eval/run_eval.py to re-calibrate.
RELEVANCE_THRESHOLD=3.0
MAX_CONCURRENT_QUERIES=3
TEMPERATURE=0.1
# Output length is hardcoded (max_tokens/num_predict=1024) in
# rag/generator.py, not read from the environment — edit it there directly
# if you need a different budget.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
QUERY_EXPANDER_MODEL=qwen2.5:7b
PDF_OCR_LANGUAGE=eng

# Upload/ingestion limits
MAX_UPLOAD_MB=50
MAX_BATCH_FILES=20
MAX_PDF_PAGES=500
OCR_TIMEOUT_SECONDS=60
# Wall-clock budget for OCR across a WHOLE document, not per page — without
# this, a scan where every page needs OCR could legitimately run for
# MAX_PDF_PAGES * OCR_TIMEOUT_SECONDS (hours). Once exhausted, remaining
# scanned pages are left empty rather than attempted.
MAX_TOTAL_OCR_SECONDS=600
# Concurrent parse/OCR/embed/upsert jobs across /upload + /upload-batch —
# embedding is already serialized onto one GPU worker (rag/executors.py),
# this mainly bounds CPU-bound PDF parsing/OCR running in parallel.
MAX_CONCURRENT_INGESTIONS=2

# API authentication (leave empty to disable)
API_KEY=your-secret-key-here
